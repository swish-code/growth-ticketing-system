# Postgres connection string (Railway provides this automatically).
DATABASE_URL=postgresql://user:password@host:5432/database

# Port the Express server listens on.
PORT=8080

# Set to "production" on Railway so session cookies are marked Secure.
NODE_ENV=production

# --- Email notifications (optional — disabled until all three are set) ------
# Sent to the requester, the assignee and the acting staff member whenever a
# request is created, accepted, declined, scheduled, completed or updated.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_SECURE=true          # only for implicit-TLS ports such as 465
SMTP_USER=notifications@swishhh.net
SMTP_PASS=your-app-password
# MAIL_FROM="Growth Department <notifications@swishhh.net>"
APP_URL=https://growth-ticketing-system-production.up.railway.app
